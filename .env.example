# OpenAI key. Used for text-embedding-3-small embeddings in live mode. Leave unset for the offline hash embedder.
OPENAI_API_KEY=
# Anthropic key. Used for the LLM reranker and the answer stage in live mode. Leave unset for lexical rerank plus replay answers.
ANTHROPIC_API_KEY=
# Optional. Anthropic model for rerank and answer stages. Defaults to claude-haiku-4-5.
RAG_CHAT_MODEL=
# Optional. OpenAI embedding model. Defaults to text-embedding-3-small.
RAG_EMBED_MODEL=
# Optional. Folder of markdown docs to index instead of data/corpus (for example data/corpus-fetched after npm run fetch-corpus).
RAG_CORPUS_DIR=
